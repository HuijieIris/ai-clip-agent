# ===== ASR 通道选择 =====
# auto（默认）：优先火山；只有开启本地兜底才允许自动使用 Whisper
# volc：固定火山主通道；whisper：手动选择本地通道
ASR_PROVIDER=auto
# 火山未配置或识别失败时，是否允许本地兜底（默认关闭）
ASR_LOCAL_FALLBACK=0

# ===== 本地 Whisper（可选兜底，不使用云端凭据）=====
# Python openai-whisper：
# LOCAL_WHISPER_BACKEND=python
# LOCAL_WHISPER_BIN=whisper
# LOCAL_WHISPER_MODEL=small
# whisper.cpp（参数与结果已独立适配；模型必须提前下载）：
# LOCAL_WHISPER_BACKEND=cpp
# LOCAL_WHISPER_BIN=whisper-cli
# LOCAL_WHISPER_MODEL=/absolute/path/to/ggml-small.bin
# LOCAL_WHISPER_LANG=auto
# LOCAL_WHISPER_CHUNK_SECONDS=600
# LOCAL_WHISPER_CONCURRENCY=2
# LOCAL_WHISPER_TIMEOUT_MS=3600000
# LOCAL_WHISPER_PROMPT=科沃斯，钱程，创二代

# ===== 语音转写：字节火山引擎 ASR（录音文件识别·大模型）=====
# 控制台路径：语音技术 → 录音文件识别 → 创建应用，拿 AppID 与 Access Token
# 新版语音控制台 API Key（推荐，不是通用 AK/SK）
VOLC_API_KEY=
VOLC_RESOURCE_ID=volc.seedasr.auc
# 旧版鉴权仍兼容；已填写 API Key 时优先使用 API Key
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# 以下一般不用改，按账号实际开通情况调整
# VOLC_RESOURCE_ID=volc.bigasr.auc
# VOLC_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel

# 长音频分片（默认每 10 分钟一片，2 小时视频约 12 片）
# VOLC_CHUNK_SECONDS=600
# 并发与轮询
# VOLC_CONCURRENCY=2
# VOLC_POLL_INTERVAL_MS=1500
# VOLC_POLL_TIMEOUT_MS=600000
# 单次 HTTP 请求超时，避免网络请求一直挂起
# VOLC_REQUEST_TIMEOUT_MS=30000
# 单片失败重试（指数退避，只对限流/网络类错误重试）
# VOLC_RETRY_ATTEMPTS=3
# VOLC_RETRY_BASE_MS=800

# 单条字幕建议最大字数，超出会按标点继续断句（默认 20）
# ASR_MAX_CUE_CHARS=20

# 音频预处理，默认关闭。嘈杂的发布会/访谈可开：
# ASR_AUDIO_FILTER=highpass=f=80,dynaudnorm=f=250

# 转写结果缓存，同一段音频重复分析不重复计费（默认开启）
# ASR_CACHE=0

# 透传给火山的额外 request 字段（JSON），用于账号侧特殊能力如热词表，
# 避免在代码里猜字段名。示例：{"boosting_table_name":"你的热词表名"}
# VOLC_EXTRA_REQUEST_JSON=

# ===== 高光推荐：OpenAI 兼容网关（可选）=====
# 旧配置兼容；未配置模型时保留逐字稿并报错，不再静默规则降级
# 配了之后，高光由大模型读取逐字稿产出具体理由
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini

# 高光网关不会用于语音转写，ASR 与文本模型凭据完全分离。

# PORT=8788

# ===== 双语 AI 高光推荐（独立于火山语音 API Key）=====
# HIGHLIGHT_API_KEY=
# HIGHLIGHT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HIGHLIGHT_MODEL=qwen-plus
# 总工作流超时，默认10分钟；每次模型请求最多90秒
# HIGHLIGHT_WORKFLOW_TIMEOUT_MS=600000
# 兼容旧 OPENAI_API_KEY / OPENAI_BASE_URL / CHAT_MODEL，但不会复用语音 Key。

# ===== 通用联网搜索（可选，新闻/翻译术语/背景/事实）=====
# TAVILY_API_KEY=
# 未配置会明确标记 unavailable；每视频最多6次检索、累计45秒。

# ===== 候选原音频理解（可选，真实语气与疑点复听）=====
# 使用支持 OpenAI 兼容 input_audio + SSE 文本输出的 Qwen-Omni 模型。
# AUDIO_REVIEW_API_KEY=
# AUDIO_REVIEW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AUDIO_REVIEW_MODEL=qwen3.5-omni-plus
# 每次最多复听5条候选，每条最多120秒。未配置不会用文本假装听见语气。
# 本地ASR自动识别语言：LOCAL_WHISPER_LANG=auto（现在默认auto）

# 标题独立使用 DeepSeek；翻译及高光分析保留现有模型
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# BGM 推荐默认复用 DeepSeek，可独立配置以下服务端变量
# MUSIC_API_KEY=
# MUSIC_BASE_URL=https://api.deepseek.com
# MUSIC_MODEL=deepseek-flash
